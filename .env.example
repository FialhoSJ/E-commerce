# Administrative access. Keep these values on the server only.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Required by the admin catalog and persistent orders.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
SUPABASE_STORAGE_BUCKET=products

# AbacatePay Dev mode. Keep the API key server-only.
ABACATEPAY_API_KEY=
# Create a webhook in AbacatePay and use this same value as its secret.
ABACATEPAY_WEBHOOK_SECRET=

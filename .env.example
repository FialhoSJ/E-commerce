# Administrative access. Keep these values on the server only.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Required by the admin catalog and persistent orders.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
SUPABASE_STORAGE_BUCKET=products

# Supabase Auth for customer accounts. The publishable key is safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-your-publishable-key-here

# Asaas. Keep secrets server-only. Use sandbox locally and production in the live site.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=replace-with-your-server-secret
# Configure the same token in the Asaas webhook's authentication settings.
ASAAS_WEBHOOK_TOKEN=replace-with-your-server-secret
